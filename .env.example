# ==============================================================================
# TariffGuard — Root Environment Configuration Template
# Copy this file to .env and fill in your secrets.
# ==============================================================================

# --- Database Configuration ---
# Option 1: Aiven Cloud MySQL (Recommended for Cloud / Staging / Production)
DATABASE_URL=mysql+pymysql://avnadmin:YOUR_AIVEN_PASSWORD@mysql-xxxx-your-project.aivencloud.com:12345/defaultdb?ssl_mode=REQUIRED

# Option 2: Local MySQL (via Docker Compose or local server)
# DATABASE_URL=mysql+pymysql://tariffguard_user:tariffguard_pass@localhost:3306/tariffguard

# Option 3: Local SQLite fallback
# DATABASE_URL=sqlite:///./test.db

# Optional: Path to downloaded SSL CA certificate (if required by custom SSL proxy)
# DB_SSL_CA=./ca.pem

# --- Application Settings ---
ENVIRONMENT=development
DEBUG=true

# --- AI & Cloud Services (Alibaba Cloud Model Studio / Qwen) ---
# Get API key from Alibaba Cloud DashScope console
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
ALCHEMY_KEY=your_alchemy_key_here

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
