# ==============================================================================
# TariffGuard — Backend Environment Variables
# ==============================================================================

# Database Connection (Aiven MySQL / Local MySQL / SQLite)
DATABASE_URL=mysql+pymysql://avnadmin:YOUR_AIVEN_PASSWORD@mysql-xxxx-your-project.aivencloud.com:12345/defaultdb?ssl_mode=REQUIRED

# Optional SSL CA certificate path
# DB_SSL_CA=ca.pem

# App Environment
ENVIRONMENT=development
DEBUG=true

# AI Advisor (Qwen LLM / DashScope)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
ALCHEMY_KEY=
