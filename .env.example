# Alibaba Cloud Keys (replace with actual values)
ALCHEMY_KEY=your_actual_key_here
QWEN_API_KEY=your_actual_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Database (local Docker)
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_DATABASE=tariffguard
MYSQL_USER=tariffguard_user
MYSQL_PASSWORD=tariffguard_pass

# Weather / Solar (Open-Meteo — free, no key required)
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
FAISALABAD_LAT=31.4167
FAISALABAD_LON=73.0833
FAISALABAD_TZ=Asia/Karachi
